{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --prefix admin",
  "buildCommand": "npm run build --prefix admin",
  "outputDirectory": "admin/dist",
  "env": {
    "VITE_API_URL": "https://dt-car-bazaar-api.onrender.com/api"
  },
  "rewrites": [
    {
      "source": "/((?!privacy-policy\\.html|terms-of-service\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
