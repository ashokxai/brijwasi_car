# Dependencies
node_modules/

# Builds
dist/
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/android/.gradle/
**/android/app/build/
**/ios/Pods/
**/ios/.symlinks/
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# Uploads (keep folder)
uploads/*
!uploads/.gitkeep

# Secrets / local env (never commit real values)
.env
.env.local
.env.development
.env.production
.env.*.local
!.env.example
!**/.env.example
!.env.production.example
!**/.env.production.example
!.env.render.example
!**/.env.render.example

# Firebase / Google client configs with keys (keep local only)
**/google-services.json
**/GoogleService-Info.plist
!**/google-services.json.example

# Service accounts & key material
*firebase-adminsdk*.json
*serviceAccount*.json
*-adminsdk-*.json
**/render-firebase-env*.txt
**/*credentials*.json
**/*.pem
**/*.p12

# OS / IDE
.DS_Store
*.log
coverage/
.idea/
.vscode/
*.iml

# Misc
*.apk
*.aab
*.ipa
.vercel

# Local generated Firebase options (may contain API keys)
**/firebase_options.local.dart
**/firebase_options.local.*.dart
