PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/dt_car_bazaar
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=1d

# Admin website URL (Vercel domain after deploy)
CLIENT_URL=http://localhost:5173
# Comma-separated extra allowed origins, e.g. https://your-admin.vercel.app
CORS_ORIGINS=http://localhost:5173

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
CONTACT_PHONE=+918630930402
CONTACT_WHATSAPP=918630930402
NODE_ENV=development

# Firebase Admin (Render): paste the full service-account JSON as one line
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Cloudinary (free image hosting)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
